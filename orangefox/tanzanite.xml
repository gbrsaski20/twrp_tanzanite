<?xml version="1.0" encoding="UTF-8"?>
<!--
  REFERENCE MANIFEST - not consumed by the build.

  The OrangeFox workflow clones these two projects directly with git, because
  orangefox_sync.sh patches .repo/manifests and a follow-up "repo sync" can
  refuse to run on a locally modified manifest. This file records exactly
  which projects and branches the build uses.

  The device tree already ships OrangeFox support:
    - fox_tanzanite.mk   (OF_* feature flags, inherited by device.mk)
    - vendorsetup.sh     (FOX_* build vars, FOX_VENDOR_BOOT_RECOVERY=1)
  so the same tree builds both TWRP and OrangeFox.
-->
<manifest>
    <project name="puuuuh/recovery_device_xiaomi_tanzanite" path="device/xiaomi/tanzanite" remote="github" revision="12.1_aosp" />
    <project name="puuuuh/android_device_xiaomi_tanzanite-kernel" path="device/xiaomi/tanzanite-kernel" remote="github" revision="vanilla" />
</manifest>

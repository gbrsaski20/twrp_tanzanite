# Normalize line endings
* text=auto

# Shell scripts must stay LF (CRLF breaks bash)
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# Windows scripts should be CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Android device files: init/fstab/scripts must be LF in the blob
# (CRLF breaks init.rc parsing, fstab flags and shebang).
a17/**     text eol=lf
*.mt6789   text eol=lf
*.rc       text eol=lf

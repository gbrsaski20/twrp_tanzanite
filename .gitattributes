# Normalize line endings
* text=auto

# Shell scripts must stay LF (CRLF breaks bash)
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# Windows scripts should be CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

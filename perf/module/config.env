# =============================================================================
# Tanzanite OC - settings
#
# Edit this file, then reboot (or re-flash the zip).
# Anything left at 0 in ENABLE disables that part entirely.
#
# CLUSTERS
#   C0 = little  (6x Cortex-A55)   stock 2000 MHz
#   C1 = big     (2x Cortex-A76)   stock 2200 MHz
#
# VOLTAGE IS THE DANGEROUS PART
#   Too low  -> instant freeze at that clock.
#   Too high -> degrades the silicon over time.
#   Raise it in 25 mV steps only when a clock freezes.
# =============================================================================

CPU_ENABLE=1
CPU_C0_MHZ=2300
CPU_C0_MV=950
CPU_C1_MHZ=2500
CPU_C1_MV=1100

# GPU: stock top is 1100 MHz @ 900 mV. Leave at 0 until CPU is proven stable -
# one variable at a time, otherwise you cannot tell what froze the phone.
GPU_ENABLE=0
GPU_MHZ=1150
GPU_MV=930

# Seconds to wait after boot_completed before applying. The gauge, thermal and
# cpuhvfs modules all need to be up; applying too early is the usual reason a
# boot-time OC appears to "not stick".
APPLY_DELAY=10

# Seconds the phone must stay alive after applying before the boot counter is
# cleared. If it freezes before this, the counter keeps climbing and the module
# disables itself on the 4th boot.
SURVIVE_SECONDS=30

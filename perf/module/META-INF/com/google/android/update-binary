#!/sbin/sh
# =============================================================================
# Recovery installer for tanzanite_oc
# Works in TWRP / OrangeFox. The same zip is also accepted by KernelSU and
# Magisk as a module, because module.prop sits at the archive root and
# updater-script contains the #MAGISK marker.
# =============================================================================

OUTFD=$2
ZIPFILE=$3
MODID=tanzanite_oc
MODPATH=/data/adb/modules/$MODID

ui_print() {
	echo "ui_print $1" >&$OUTFD
	echo "ui_print " >&$OUTFD
}

ui_print "=============================================="
ui_print " Tanzanite OC - MT6789 CPU + GPU"
ui_print "=============================================="

# /data must be mounted for the module to land in the right place
if [ ! -d /data/adb ]; then
	ui_print "- /data not mounted, trying to mount it"
	mount /data 2>/dev/null
fi

if [ ! -d /data/adb ]; then
	ui_print "! /data/adb still missing."
	ui_print "! Decrypt /data first (enter your pattern), then flash again."
	exit 1
fi

ui_print "- Installing to $MODPATH"

rm -rf "$MODPATH"
mkdir -p "$MODPATH"
mkdir -p /data/adb/tanzanite_oc

TMP=/tmp/tanzanite_oc_unzip
rm -rf "$TMP"
mkdir -p "$TMP"

unzip -o "$ZIPFILE" -x "META-INF/*" -d "$TMP" >/dev/null 2>&1
if [ ! -f "$TMP/module.prop" ]; then
	ui_print "! Extraction failed - module.prop not found."
	exit 1
fi

cp -af "$TMP"/. "$MODPATH"/
rm -rf "$TMP"

chmod 755 "$MODPATH/service.sh" 2>/dev/null
chmod 755 "$MODPATH/uninstall.sh" 2>/dev/null
chmod 755 "$MODPATH/common/oc_apply.sh" 2>/dev/null
chmod 644 "$MODPATH/module.prop" "$MODPATH/config.conf" 2>/dev/null

# start with a clean counter so a previous failed experiment does not block
rm -f /data/adb/tanzanite_oc/bootcount

if [ ! -f /proc/cpuhvfs/phyclk ]; then
	ui_print "! NOTE: /proc/cpuhvfs/phyclk not found."
	ui_print "! CPU overclock will be skipped on this kernel."
	ui_print "! GPU part still works if /proc/gpufreqv2 exists."
fi

ui_print "- Installed."
ui_print ""
ui_print "Next boot applies:"
grep -E '^(A55|A76|GPU)_' "$MODPATH/config.conf" | while read -r line; do
	ui_print "   $line"
done
ui_print ""
ui_print "Auto-disable after 2 failed boots is ON."
ui_print "Log: /data/adb/modules/tanzanite_oc/last.log"
ui_print "Reboot to activate."

exit 0
